# AI planner + narration
OPENAI_API_KEY=

# Cost-sensitive multimodal editor brain
OPENAI_EDITOR_MODEL=gpt-5.6-luna

# Timestamp-capable transcription. whisper-1 remains the conservative default
# for segment timestamps in this starter.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Text-to-speech narration
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# openai | local
TRANSCRIBE_PROVIDER=openai

# Local transcription only (pip install -r requirements-local.txt)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

SCENE_THRESHOLD=27
MAX_UPLOAD_MB=1500
DATA_DIR=/app/data
