#!/usr/bin/env python3
import subprocess
import sys
from pathlib import Path

import cv2
import imageio_ffmpeg

args = sys.argv[1:]
path = Path(args[-1]) if args else None

if path and "format=duration" in " ".join(args):
    cap = cv2.VideoCapture(str(path))
    try:
        fps = float(cap.get(cv2.CAP_PROP_FPS) or 0)
        frames = float(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
    finally:
        cap.release()
    if fps <= 0 or frames <= 0:
        sys.exit(1)
    print(max(0.1, frames / fps))
    sys.exit(0)

if path and "stream=codec_type" in " ".join(args):
    binary = imageio_ffmpeg.get_ffmpeg_exe()
    proc = subprocess.run([binary, "-hide_banner", "-i", str(path)], capture_output=True, text=True)
    if "Audio:" in (proc.stderr or ""):
        print("audio")
        sys.exit(0)
    sys.exit(1)

sys.exit(1)
